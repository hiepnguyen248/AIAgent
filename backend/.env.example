# AI Automation Hub Backend

# LLM Provider: "exacode" or "ollama"
LLM_PROVIDER=exacode

# EXACODE (LGE)
EXACODE_API_KEY=your-api-key-here
EXACODE_BASE_URL=http://exacode-chat.lge.com/v1
EXACODE_MODEL=Chat-EXACODE-A

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# CodeBeamer
CODEBEAMER_URL=http://vscb.lge.com:8080/cb
CODEBEAMER_USERNAME=autotest
CODEBEAMER_PASSWORD=your-password-here
CODEBEAMER_SSL_VERIFY=false

# RAG (Retrieval-Augmented Generation)
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_PERSIST_DIR=./rag_data

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=ai_automation_hub

